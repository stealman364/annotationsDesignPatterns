{
  "entryPoints": [
    "../../src/index.ts",
    "../../src/decorators/index.ts",
    "../../src/public/operators.ts",
    "../../src/public/pipe.ts",
    "../../src/public/run.ts",
    "../../src/policy/index.ts",
    "../../src/observability/index.ts",
    "../../src/node/index.ts",
    "../../src/store/index.ts",
    "../../src/experimental/index.ts"
  ],
  "tsconfig": "./tsconfig.typedoc.json",
  "excludeInternal": true,
  "excludePrivate": true,
  "readme": "none",
  "sort": ["source-order"],
  "treatWarningsAsErrors": true,
  "intentionallyNotExported": [
    "BuilderMethods",
    "Provider",
    "Ctor",
    "Operator",
    "AnyMethod",
    "MaybePromise",
    "FallbackValue",
    "ValidStates",
    "CounterLabels",
    "Attributes",
    "RetryInvocationContext",
    "RetryAttemptEvent",
    "RetryExhaustedEvent",
    "TimeoutTriggeredEvent",
    "CircuitOpenEvent",
    "CircuitHalfOpenEvent",
    "CircuitClosedEvent",
    "CacheHitEvent",
    "CacheMissEvent",
    "CacheRejectedEvent",
    "CacheInvalidatedEvent",
    "FallbackUsedEvent",
    "SemaphoreQueuedEvent",
    "SemaphoreAcquiredEvent",
    "SemaphoreReleasedEvent",
    "OverlapStartedEvent",
    "OverlapQueuedEvent",
    "OverlapDroppedEvent",
    "OverlapCompletedEvent",
    "KeyedLockQueuedEvent",
    "KeyedLockAcquiredEvent",
    "KeyedLockReleasedEvent"
  ],
  "out": "public/api"
}
