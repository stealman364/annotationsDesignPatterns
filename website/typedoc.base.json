{
  "tsconfig": "./tsconfig.typedoc.json",
  "excludeInternal": true,
  "excludePrivate": true,
  "readme": "none",
  "sort": ["source-order"],
  "plugin": ["typedoc-plugin-markdown"],
  "treatWarningsAsErrors": true,
  "intentionallyNotExported": [
    "BuilderMethods",
    "Provider",
    "Ctor",
    "Operator",
    "AnyMethod",
    "MaybePromise",
    "EventSink",
    "FallbackValue",
    "PolicyErrorCode",
    "PolicyErrorOptions",
    "RetryInvocationContext",
    "OverlapKeyContext",
    "RetryAttemptEvent",
    "RetryExhaustedEvent",
    "TimeoutTriggeredEvent",
    "CircuitOpenEvent",
    "CircuitHalfOpenEvent",
    "CircuitClosedEvent",
    "CacheHitEvent",
    "CacheMissEvent",
    "CacheRejectedEvent",
    "CacheInvalidatedEvent",
    "FallbackUsedEvent",
    "SemaphoreQueuedEvent",
    "SemaphoreAcquiredEvent",
    "SemaphoreReleasedEvent",
    "OverlapStartedEvent",
    "OverlapQueuedEvent",
    "OverlapDroppedEvent",
    "OverlapCompletedEvent",
    "KeyedLockQueuedEvent",
    "KeyedLockAcquiredEvent",
    "KeyedLockReleasedEvent"
  ]
}
