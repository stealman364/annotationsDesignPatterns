{
  "name": "annotations-design-patterns-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run prepare:content && astro dev",
    "dev": "npm run start",
    "build": "npm run check:i18n && npm run prepare:content && npm run build:api && npm run verify:typedoc && astro build && npm run verify",
    "build:all": "npm run build",
    "preview": "astro preview",
    "serve": "astro preview",
    "prepare:content": "node scripts/prepare-content.mjs",
    "prepare:typedoc": "node scripts/prepare-typedoc.mjs",
    "build:api": "npm run prepare:typedoc && node scripts/build-api.mjs",
    "verify:typedoc": "npm run prepare:typedoc && node scripts/verify-typedoc-globs.mjs",
    "check:i18n": "node scripts/check-i18n-parity.mjs",
    "verify": "node scripts/verify-output.mjs"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "overrides": {
    "typedoc@0.28.20": {
      "minimatch": "11.0.5"
    }
  },
  "devDependencies": {
    "@astrojs/markdown-remark": "7.3.6",
    "@astrojs/starlight": "0.42.10",
    "astro": "7.4.7",
    "@types/node": "26.6.6",
    "typedoc": "0.28.20",
    "typescript": "7.0.2"
  }
}
